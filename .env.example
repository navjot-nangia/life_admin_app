# No service credentials are required for manual tracking on Sites.
# Sites provisions DB, BUCKET, HTTPS and trusted ChatGPT identity forwarding.
# Do not expose the Worker directly to the internet with trusted header auth.

# Optional AI extraction (server secrets, never NEXT_PUBLIC_ variables):
AI_API_KEY=
# Choose a current Anthropic model supporting images and PDF documents.
AI_MODEL=

# Optional Web Push. Set the SAME values for the app and scheduler worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required for the scheduler; use a monitored contact, e.g. mailto:you@example.org
VAPID_SUBJECT=

# Railway-only private gateway. Use a long, unique password.
LIFE_ADMIN_USERNAME=
LIFE_ADMIN_PASSWORD=
LIFE_ADMIN_EMAIL=
LIFE_ADMIN_NAME=
# Set automatically when a Railway volume is mounted.
RAILWAY_VOLUME_MOUNT_PATH=
